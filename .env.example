# ── Gemini (optional) ────────────────────────────────────────────────────────
# Without a key CalorAI runs on its deterministic offline engine (same RAG grounding,
# rule-based dialogue). With a key you get the full LangGraph + Gemini agent,
# photo analysis, LLM memory extraction and the dense retrieval channel.
GOOGLE_API_KEY=

# CALORAI_CHAT_MODEL=gemini-3.1-flash-lite
# CALORAI_VISION_MODEL=gemini-3.1-flash-lite
# CALORAI_MEMORY_MODEL=gemini-3.1-flash-lite
# CALORAI_EMBEDDING_MODEL=gemini-embedding-001
# CALORAI_ENABLE_DENSE=true
# CALORAI_LLM_MODE=auto            # auto | gemini | offline

# ── Storage ──────────────────────────────────────────────────────────────────
CALORAI_DB_PATH=calorai.db
# CALORAI_UPLOAD_DIR=uploads
# CALORAI_CACHE_DIR=.cache
# CALORAI_MAX_UPLOAD_MB=8
# CALORAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=calorai
